{
  "name": "ciphernest",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "setup": "./setup.sh",
    "setup:clean": "./setup.sh --clean",
    "dev": "cd src/chat_frontend && pnpm run dev",
    "dev:backend": "dfx start --background && dfx deploy chat_backend",
    "dev:frontend": "cd src/chat_frontend && pnpm run dev",
    "build": "cd src/chat_frontend && pnpm run build",
    "build:backend": "dfx build chat_backend",
    "start": "cd src/chat_frontend && pnpm run start",
    "lint": "cd src/chat_frontend && pnpm run lint || true",
    "format": "prettier --write .",
    "typecheck": "tsc -p src/chat_frontend/tsconfig.json",
    "stop": "dfx stop",
    "clean": "dfx stop && rm -rf .dfx && cd src/chat_frontend && rm -rf .next node_modules",
    "logs": "dfx canister logs chat_backend",
    "status": "dfx canister status --all"
  },
  "dependencies": {
    "agent-js": "npm:@dfinity/agent@^0.12.0",
    "@dfinity/agent": "^0.12.0",
    "@dfinity/auth-client": "^0.4.0",
    "@dfinity/principal": "^3.0.0",
    "@dfinity/candid": "^0.10.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.3.10",
    "framer-motion": "^10.0.0",
    "tailwindcss": "^3.5.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "lucide-react": "^0.268.0",
    "@radix-ui/react-dropdown-menu": "^1.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "react-use": "^17.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/react": "^18.2.0",
    "@types/node": "^20.0.0",
    "prettier": "^2.8.8",
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.0.0"
  }
}
